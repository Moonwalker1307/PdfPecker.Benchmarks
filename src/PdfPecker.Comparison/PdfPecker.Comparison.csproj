<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compares PdfPecker with other .NET HTML-to-PDF converters. Usage is at the top of Program.cs. -->
  <ItemGroup>
    <PackageReference Include="itext.pdfhtml" Version="6.3.4" />
    <PackageReference Include="Syncfusion.HtmlToPdfConverter.Net.Linux" Version="35.1.40" />
    <PackageReference Include="PuppeteerSharp" Version="25.13.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="HtmlRenderer.PdfSharp" Version="1.6.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(PdfPeckerRoot)' == ''">
    <PackageReference Include="PdfPecker" Version="$(PdfPeckerVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PdfPeckerRoot)' != ''">
    <ProjectReference Include="$(PdfPeckerRoot)/src/PdfPecker/PdfPecker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="html/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
